# Korean Land MCP Configuration
# === 실제 데이터 연동을 위한 API 키 (선택사항) ===
# vworld.kr (무료 키 발급 추천) → https://vworld.kr
VWORLD_API_KEY=your_vworld_key_here

# data.go.kr 서비스키 (일부 토지 데이터셋)
# DATA_GO_KR_KEY=your_data_gov_key_here

# MCP Server Port (for HTTP mode)
PORT=3000

# Optional: Logging level
LOG_LEVEL=info

# Optional: override the V-World base URL (relay / offline fixture server). Default https://api.vworld.kr/req
# VWORLD_BASE_URL=https://api.vworld.kr/req

# Remote secure MCP mode (e.g. Oracle VM + HTTPS reverse proxy).
# MUST be a strong independent secret; do not publish its value or place in git.
# Keep MCP_TRANSPORT unset for local stdio.
# MCP_TRANSPORT=http
# MCP_BEARER_TOKEN=<random-32-plus-character-token>
# The external URL must use HTTPS and reverse proxy to http://127.0.0.1:3000/mcp.
